# Application Environment
NODE_ENV=development
PORT=5000

# MongoDB Database Connection URL
DATABASE_URL="mongodb://localhost:27017/sopifest?authSource=admin"

# JWT Authentication Secrets (Ensure strong random keys in production)
JWT_ACCESS_SECRET=super_secret_access_token_key_change_in_production_12345
JWT_REFRESH_SECRET=super_secret_refresh_token_key_change_in_production_12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:3000

# Stripe Online Payments (Stripe-only gateway for Task 35).
# Leave blank for mock mode (dev/test without live keys).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=usd
